
local.file_match "flask_logs" {
  path_targets = [
    {
      __path__ = "/var/log/flask/*.log",
      job      = "flask-app",
    },
  ]
}

loki.source.file "flask_logs" {
  targets    = local.file_match.flask_logs.targets
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
